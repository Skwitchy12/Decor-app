{
  "name": "DECOR",
  "short_name": "DECOR",
  "description": "Furniture and decoration ideas in white, brown and black, with room planning and color tools.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fffdfa",
  "theme_color": "#7a5230",
  "lang": "en",
  "dir": "auto",
  "categories": [
    "lifestyle",
    "shopping"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse ideas",
      "url": "/#ideas"
    },
    {
      "name": "Design studio",
      "url": "/#studio"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+decor",
      "url": "/?idea=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "note_taking": {
    "new_note_url": "/?note=1"
  },
  "prefer_related_applications": false,
  "related_applications": [],
  "widgets": [
    {
      "name": "DECOR idea of the day",
      "short_name": "Idea",
      "description": "A new decor idea every day.",
      "tag": "idea-of-the-day",
      "ms_ac_template": "/widgets/idea-template.json",
      "data": "/widgets/idea-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/widgets/widget-preview.png",
          "sizes": "387x387",
          "label": "Idea of the day widget"
        }
      ],
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ]
}